{
  "name": "bug-detector-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync-metrics && vite",
    "build": "npm run sync-metrics && tsc -b && vite build",
    "preview": "vite preview",
